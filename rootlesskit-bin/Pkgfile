# Description: Linux-native fakeroot using user namespaces
# URL: https://github.com/rootless-containers/rootlesskit
# Maintainer: Juergen Daubert, jue at crux dot nu

name=rootlesskit-bin
version=2.3.6
release=1
source=(https://github.com/rootless-containers/rootlesskit/releases/download/v$version/rootlesskit-armv7l.tar.gz)
renames=(rootlesskit-$version-armv7l.tar.gz)

build() {
    install -d $PKG/usr/bin
    install rootlesskit $PKG/usr/bin
}
