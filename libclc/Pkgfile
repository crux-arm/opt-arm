# Description: libclc is an implementation of the library requirements of the OpenCL C programming language
# URL: https://libclc.llvm.org/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: clang lld spirv-llvm-translator

name=libclc
version=22.1.3
release=1
source=(https://github.com/llvm/llvm-project/releases/download/llvmorg-$version/llvm-project-$version.src.tar.xz)

build() {
  # Strip mcpu|march|mtune flags
  shopt -s extglob
  CFLAGS="${CFLAGS// -@(mcpu|march|mtune)=+([![:space:]]) / }"
  shopt -u extglob

  # libclc is intended to be used with the Clang compiler's OpenCL frontend
  export CC=clang CXX=clang++ AR=llvm-ar NM=llvm-nm RANLIB=llvm-ranlib LDFLAGS+=' -fuse-ld=lld'

  cmake -S llvm-project-$version.src/libclc -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_INSTALL_LIBDIR=lib \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
    -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
    -D LLVM_DEFAULT_TARGET_TRIPLE=$(gcc -dumpmachine) \
    -D CMAKE_C_COMPILER_WORKS=ON \
    -D CMAKE_CXX_COMPILER_WORKS=ON \
    -Wno-dev

  cmake --build build
  DESTDIR=$PKG cmake --install build
}
